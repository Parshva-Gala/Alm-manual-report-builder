<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="utf-8">
<title>Working</title>
<hta:application id="prog" applicationname="JKBProgress" border="thin" scroll="no"
  singleinstance="no" maximizebutton="no" minimizebutton="yes" sysmenu="yes" contextmenu="no" />
<style type="text/css">
/* ===========================================================================
   Progress window, design system v2.

   Excel's status bar is the wrong place for work that takes minutes: easy to
   miss, says nothing about how much is left, and often not repainted while
   VBA is busy. The workbook writes a small status file (modShared_Progress)
   and this separate process polls it, so it keeps drawing however hard Excel
   is working. File format: key=value lines - title, sub, state
   (running|done|failed), pct (0..1), step, detail, eta, elapsed, log (a|b|c).
   =========================================================================== */
*{box-sizing:border-box;}
html,body{height:100%;margin:0;padding:0;overflow:hidden;}
body{font-family:"Segoe UI",Arial,sans-serif;font-size:13px;color:#101828;background:#FFFFFF;}
#head{padding:22px 24px 0 24px;height:78px;}
#badge{float:left;width:40px;height:40px;border-radius:10px;background:#EEF3FB;color:#193F89;text-align:center;line-height:40px;margin-right:14px;}
#badge.done{background:#ECFDF3;color:#067647;}
#badge.failed{background:#FEF3F2;color:#B42318;}
h1{margin:0;font-size:16px;font-weight:600;letter-spacing:-.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#sub{color:#667085;font-size:12.5px;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#body{padding:6px 24px 0 24px;}
#stepline{margin:6px 0 10px 0;}
#step{font-size:13.5px;font-weight:600;color:#101828;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#detail{font-size:12px;color:#667085;height:18px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
#bar{height:8px;background:#F2F4F7;border-radius:4px;overflow:hidden;margin:4px 0 8px 0;}
#fill{height:8px;width:0%;background:#193F89;border-radius:4px;}
#fill.done{background:#17B26A;}
#fill.failed{background:#F04438;}
#meta{font-size:12px;color:#667085;}
#meta b{color:#101828;font-weight:600;}
#meta .r{float:right;}
#logwrap{margin-top:18px;border:1px solid #EAECF0;border-radius:10px;overflow:hidden;}
#logwrap .t{font-size:11.5px;font-weight:600;color:#475467;padding:8px 12px;background:#F9FAFB;border-bottom:1px solid #EAECF0;}
#log{height:128px;overflow:auto;padding:4px 0;}
#log div{padding:4px 12px;font-size:12.5px;color:#344054;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#log .tick{display:inline-block;width:16px;height:16px;border-radius:50%;background:#ECFDF3;color:#067647;font-size:10px;text-align:center;line-height:16px;margin-right:9px;font-weight:700;}
#log .now .tick{background:#EEF3FB;color:#193F89;}
#log .now{color:#101828;font-weight:600;}
#log .none{color:#98A2B3;}
#foot{position:absolute;left:0;right:0;bottom:0;height:60px;padding:14px 24px;border-top:1px solid #EAECF0;background:#FCFCFD;}
#note{font-size:12px;color:#667085;line-height:32px;}
.btn{float:right;height:32px;line-height:30px;padding:0 16px;border:1px solid #D0D5DD;border-radius:8px;background:#FFFFFF;font-size:12.5px;font-weight:600;cursor:pointer;color:#344054;}
.btn:hover{background:#F9FAFB;}
</style>
</head>
<body>
<div id="head">
  <div id="badge"><svg width="20" height="20" viewBox="0 0 20 20"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.7"/><line x1="10" y1="10" x2="10" y2="6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><line x1="10" y1="10" x2="13" y2="11.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></div>
  <h1 id="title">Working</h1>
  <div id="sub">You can keep using other applications while this runs.</div>
</div>
<div id="body">
  <div id="stepline"><div id="step">Starting&hellip;</div><div id="detail"></div></div>
  <div id="bar"><div id="fill"></div></div>
  <div id="meta"><b id="pct">0%</b> &nbsp;&middot;&nbsp; <span id="eta">estimating time left&hellip;</span><span class="r" id="elapsed"></span></div>
  <div id="logwrap">
    <div class="t">Steps</div>
    <div id="log"><div class="none">Nothing finished yet.</div></div>
  </div>
</div>
<div id="foot">
  <span id="note">This window closes itself when the work finishes.</span>
  <span class="btn" id="close" onclick="window.close()" style="display:none">Close</span>
</div>

<script type="text/javascript">
var FILE = "__STATUS_FILE__";
var fso = null;
try { fso = new ActiveXObject("Scripting.FileSystemObject"); } catch (e) {}
var lastLog = null, lastStep = "", finished = false, dots = 0;
var ICON_OK = '<svg width="20" height="20" viewBox="0 0 20 20"><polyline points="4.5,10.5 8.5,14 15.5,6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
var ICON_BAD = '<svg width="20" height="20" viewBox="0 0 20 20"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.7"/><line x1="10" y1="6" x2="10" y2="11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="10" cy="13.8" r="1" fill="currentColor"/></svg>';

function $(id){ return document.getElementById(id); }
function esc(s){ return String(s === null || s === undefined ? "" : s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

function read(){
  var f, txt = "", o = {}, lines, i, p;
  if (!fso) return window.JKB_STATUS || null;       /* preview outside an HTA */
  try {
    if (!fso.FileExists(FILE)) return null;
    f = fso.OpenTextFile(FILE, 1, false, -1);
    txt = f.ReadAll();
    f.Close();
  } catch (e) { return null; }                       /* mid-write: next tick */
  lines = txt.split("\n");
  for (i = 0; i < lines.length; i++){
    p = lines[i].indexOf("=");
    if (p > 0) o[lines[i].substring(0, p)] = lines[i].substring(p + 1).replace(/\r$/, "");
  }
  return o;
}

function drawLog(o){
  var parts = o.log && o.log.length ? o.log.split("|") : [], h = "", i;
  for (i = 0; i < parts.length; i++){
    if (parts[i].length) h += '<div><span class="tick">&#10003;</span>' + esc(parts[i]) + '</div>';
  }
  if (o.state === "running" && o.step) h += '<div class="now"><span class="tick">&bull;</span>' + esc(o.step) + '</div>';
  $("log").innerHTML = h || '<div class="none">Nothing finished yet.</div>';
  $("log").scrollTop = 99999;
}

function render(o){
  var pct;
  if (!o) return;
  if (o.title){ $("title").innerHTML = esc(o.title); document.title = o.title; }
  if (o.sub) $("sub").innerHTML = esc(o.sub);
  $("step").innerHTML = esc(o.step || "Working");
  $("detail").innerHTML = esc(o.detail || "");
  pct = Math.max(0, Math.min(100, Math.round(Number(o.pct || 0) * 100)));
  $("fill").style.width = pct + "%";
  $("pct").innerHTML = pct + "%";
  $("eta").innerHTML = esc(o.eta || "estimating time left…");
  $("elapsed").innerHTML = o.elapsed ? esc(o.elapsed) : "";
  if (o.log !== lastLog || o.step !== lastStep){ lastLog = o.log; lastStep = o.step; drawLog(o); }

  if (o.state === "done" || o.state === "failed"){
    finished = true;
    $("fill").className = o.state;
    $("badge").className = o.state;
    $("badge").innerHTML = o.state === "done" ? ICON_OK : ICON_BAD;
    $("fill").style.width = "100%";
    $("pct").innerHTML = o.state === "done" ? "Finished" : "Stopped";
    $("eta").innerHTML = "";
    $("step").innerHTML = esc(o.step || (o.state === "done" ? "Finished." : "Stopped."));
    drawLog(o);
    $("note").innerHTML = o.state === "done" ? "All done. This window closes in a moment." : "It stopped before finishing. Excel has the details.";
    $("close").style.display = "inline-block";
    if (o.state === "done") window.setTimeout(function(){ try { window.close(); } catch (e) {} }, 3500);
  }
}

function tick(){
  render(read());
  if (!finished) window.setTimeout(tick, 400);
}

window.onload = function(){
  try { window.resizeTo(580, 470); } catch (e) {}
  try { window.moveTo(Math.max(0, (screen.availWidth - 580) / 2), Math.max(0, (screen.availHeight - 470) / 3)); } catch (e) {}
  tick();
};
</script>
</body>
</html>
